DATABASE_URL="postgresql://persona_lab:CHANGE_ME@127.0.0.1:5432/persona_lab?schema=public"
AI_PROVIDER="mock"
META_API_KEY=""
META_MODEL="muse-spark-1.3"
APP_ORIGIN="http://127.0.0.1:3100"
# Optional absolute Chromium executable for Indic PDF export. On macOS the
# renderer uses installed Chrome by default; Linux needs a Chromium runtime.
PERSONA_PDF_BROWSER_PATH=""

# Release gates: only exact true enables a verified feature; invalid values disable it.
PERSONA_ENGLISH_TEXT="true"
# Roadmap gates remain unavailable even if set to true until implementation is verified.
PERSONA_HINDI_TEXT="false"
PERSONA_TELUGU_TEXT="false"
PERSONA_PERSONAL_EDITION="false"
PERSONA_VOICE="false"
# Optional: disable the English localhost microphone check (available in dev
# with the Meta key; independent of full voice and native-language release).
# PERSONA_SPEECH_ACCEPTANCE="false"
PERSONA_VIDEO_INPUT="false"
PERSONA_CAMERA_COACHING="false"
PERSONA_AVATAR_3D="false"
