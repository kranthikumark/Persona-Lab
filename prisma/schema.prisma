generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scenario {
  id         String   @id @default(cuid())
  slug       String
  version    Int
  catalogMetadata Json?
  localizations ScenarioLocalization[]
  definition Json
  createdAt  DateTime @default(now())
  sessions   SimulationSession[]
  publication ScenarioPublication?
  @@unique([slug, version])
}

model SimulationSession {
  id           String   @id @default(cuid())
  ownerHash    String
  scenarioId   String
  scenario     Scenario @relation(fields: [scenarioId], references: [id])
  settings     Json?
  scenarioData Json
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  branches     Branch[]
  @@index([ownerHash, createdAt])
  @@index([expiresAt])
}

model RateLimitBucket {
  key       String @id
  count     Int
  expiresAt DateTime
  @@index([expiresAt])
}

model Branch {
  id             String @id @default(cuid())
  sessionId      String
  session        SimulationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name           String
  revision       Int @default(0)
  settings       Json?
  parentBranchId String?
  parentBranch   Branch? @relation("BranchTree", fields: [parentBranchId], references: [id])
  children       Branch[] @relation("BranchTree")
  forkSnapshotId String?
  forkSnapshot   StateSnapshot? @relation("ForkPoint", fields: [forkSnapshotId], references: [id])
  createdAt      DateTime @default(now())
  messages       Message[]
  events         SimulationEvent[]
  snapshots      StateSnapshot[] @relation("BranchSnapshots")
  requests       TurnRequest[]
  evaluations    Evaluation[]
  @@index([sessionId])
}

model Message {
  id        String @id @default(cuid())
  branchId  String
  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sequence  Int
  turn      Int
  role      String
  content   String
  metadata  Json?
  sourceMetadata Json?
  createdAt DateTime @default(now())
  @@unique([branchId, sequence])
}

model SimulationEvent {
  id        String @id @default(cuid())
  branchId  String
  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sequence  Int
  turn      Int
  type      String
  payload   Json
  createdAt DateTime @default(now())
  @@unique([branchId, sequence])
}

model StateSnapshot {
  id                 String @id @default(cuid())
  branchId           String
  branch             Branch @relation("BranchSnapshots", fields: [branchId], references: [id], onDelete: Cascade)
  turnNumber         Int
  state              Json
  characterKnowledge Json
  contextVersion     String
  createdAt          DateTime @default(now())
  forkedBranches     Branch[] @relation("ForkPoint")
  @@unique([branchId, turnNumber])
}

model TurnRequest {
  id             String @id @default(cuid())
  branchId       String
  branch         Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  key            String
  inputHash      String
  resultRevision Int
  createdAt      DateTime @default(now())
  @@unique([branchId, key])
}

model Evaluation {
  id             String @id @default(cuid())
  branchId       String
  branch         Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchRevision Int
  rubricVersion  String
  localeMetadata Json?
  findings       Json
  createdAt      DateTime @default(now())
  @@unique([branchId, branchRevision, rubricVersion])
}

model ScenarioLocalization {
  id String @id @default(cuid())
  scenarioId String
  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  locale String
  version Int
  status String @default("baseline")
  content Json
  createdAt DateTime @default(now())
  @@unique([scenarioId, locale, version])
}

model PracticePreference {
  ownerHash String @id
  settings Json
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  @@index([expiresAt])
}

model ScenarioDraft {
  id String @id @default(cuid())
  ownerHash String
  revision Int @default(1)
  status String @default("draft")
  content Json
  review Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  sourceAssets ScenarioSourceAsset[]
  @@index([ownerHash, expiresAt])
}

model ScenarioSourceAsset {
  id String @id @default(uuid())
  ownerHash String
  draftId String?
  draft ScenarioDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)
  revision Int @default(1)
  status String @default("uploading")
  originalName String
  kind String
  contentType String
  byteSize Int
  sha256 String?
  durationMs Int?
  locale String
  consent Json
  failureReason String?
  processingUntil DateTime?
  createdAt DateTime @default(now())
  expiresAt DateTime
  transcripts SourceTranscript[]
  @@index([ownerHash, draftId])
  @@index([expiresAt, status])
}

model SourceTranscript {
  id String @id @default(cuid())
  assetId String
  asset ScenarioSourceAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  version Int
  text String
  translation String?
  locale String
  provider String
  model String?
  basedOnVersion Int?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([assetId, version])
}

model ScenarioPublication {
  id String @id @default(cuid())
  scenarioId String @unique
  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  draftId String
  draftRevision Int
  contentHash String
  review Json
  createdAt DateTime @default(now())
  @@unique([draftId, draftRevision])
}
