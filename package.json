{
  "name": "persona-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:speech": "playwright test --config playwright.speech.config.ts",
    "verify:speech:live": "node --conditions=react-server --import tsx scripts/verify-speech-live.ts",
    "test:catalog": "node scripts/test-scenario-studio.mjs",
    "scenario:operator": "node --conditions=react-server --import tsx scripts/scenario-operator.ts",
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "dev:locales": "PERSONA_LOCALE_ACCEPTANCE=1 next dev --hostname 127.0.0.1 --port 3100",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "verify:live": "playwright test --config playwright.live.config.ts",
    "release:check": "node --conditions=react-server --import tsx scripts/check-release.ts",
    "db:purge": "node --conditions=react-server --import tsx scripts/purge-expired.ts",
    "db:setup": "node scripts/setup-local-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --conditions=react-server --import tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "db:backup:verify": "node scripts/verify-db-backup.mjs",
    "verify:progression:live": "node --conditions=react-server --import tsx scripts/verify-progression-live.ts",
    "verify:locales:live": "node --conditions=react-server --import tsx scripts/verify-locales-live.ts",
    "verify:reports:indic": "node --conditions=react-server --import tsx scripts/verify-indic-reports.ts",
    "test:media": "node scripts/test-media-sources.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.15.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "simli-client": "^3.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
